# ==============================================================================
# OCEANWATCH AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED VARIABLES (For Data Pipeline only)
# The basic UI demo does NOT require these to be set, as artifacts are pre-generated.
# ------------------------------------------------------------------------------
CDSE_USERNAME=your_copernicus_dataspace_email
CDSE_PASSWORD=your_copernicus_dataspace_password
COPERNICUSMARINE_SERVICE_USERNAME=your_cmems_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_cmems_password

# ------------------------------------------------------------------------------
# OPTIONAL / EXTERNAL DATA VARIABLES
# ------------------------------------------------------------------------------
CDSE_S3_ACCESS_KEY=your_cdse_s3_access_key
CDSE_S3_SECRET_KEY=your_cdse_s3_secret_key

# ------------------------------------------------------------------------------
# DEVELOPMENT VARIABLES
# (Safe Defaults Provided)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://oceanwatch:oceanwatch@localhost:5432/oceanwatch
REDIS_URL=redis://localhost:6379/0

ERA5_DATA_PATH=./data/cached/era5
CMEMS_DATA_PATH=./data/cached/cmems
AIS_DATA_PATH=./data/demo/ais
OIL_MODEL_PATH=./models/oil_segmentation/best.pt
SHIP_MODEL_PATH=./models/ship_detection/best.pt
